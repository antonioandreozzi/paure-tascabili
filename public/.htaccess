Options -MultiViews
RewriteEngine On

# ─── Redirect vecchie URL WordPress → nuovo sito ───────────────────────────
RewriteRule ^filosofia/?$ /blog [R=301,L]
RewriteRule ^storytelling-educativo-per-bambini/?$ /blog [R=301,L]
RewriteRule ^category/storie-educative/?$ /blog [R=301,L]
RewriteRule ^category/(.*)$ /blog [R=301,L]
RewriteRule ^tag/scrittura-nei-bambini/?$ /blog [R=301,L]
RewriteRule ^tag/(.*)$ /blog [R=301,L]
RewriteRule ^2025/08/02/?$ /blog [R=301,L]
RewriteRule ^2025/(.*)$ /blog [R=301,L]
RewriteRule ^2026/(.*)$ /blog [R=301,L]
RewriteRule ^il-leggendario/?$ / [R=301,L]

# ─── Next.js static export: serve /percorso come /percorso/index.html ───────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# ─── Pagina 404 personalizzata ───────────────────────────────────────────────
ErrorDocument 404 /404.html
